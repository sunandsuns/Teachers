# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# 环境与密钥
.env
.env.*
!.env.example

# 前端
web/node_modules/
web/dist/
web/.vite/
# 发布用的前端副本：web/dist 一份拷贝，由 packaging/prepare_webapp.py 生成。
# 发布工具会按目录名排除 dist/build，所以不能直接把 web/dist 发上去。
/webapp/
# vite 加载 vite.config.ts 时留下的临时副本，每次启动都换一个名字
web/vite.config.ts.timestamp-*
npm-debug.log*
yarn-error.log*

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 运行时产物
*.log
/tmp/

# 源码态运行产生的数据目录（历史记录数据库）。打包态的 data/ 在 dist/ 里，
# 已由下面的 /dist/ 覆盖
/data/

# 打包产物（build_app.py 生成）
/build/
/dist/

# 云服务开通时在本机生成的应用清单，内容只有 appId 与本机绝对路径——
# 换台机器就没意义，也不该把用户名带进公开仓库
/.wbapp_*.genie

# 本地工具目录：临时脚本、界面截图、命令行代理缓存
# （.workbuddy/memory 是本地工作笔记，含绝对路径，不入库）
.workbuddy/
.v2c/
.video_agent/
.zcode/
