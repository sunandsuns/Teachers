# ── LLM 配置样例 ──────────────────────────────────────────────────────
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略。
# 真实环境变量优先级高于 .env 文件。

# 任意 OpenAI 兼容端点即可（官方 OpenAI、智谱、各类聚合中继……）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here

# 显式指定模型。留空 = 自动从下面的候选里挑一个当前可用的
LLM_MODEL=

# 候选模型，逗号分隔，按优先级排列。留空则改用端点 /models 的返回
LLM_MODEL_CANDIDATES=gpt-4o-mini,gpt-4o

# 是否允许自动挑选可用模型（1/0）
LLM_AUTO_MODEL=1

# 超时与生成参数
# LLM_TIMEOUT：单个模型生成一次的最长等待（秒）
# LLM_PROBE_TIMEOUT：探活单个候选模型的最长等待（秒）
# LLM_TOTAL_BUDGET：一次问答里"探活 + 生成"的总预算（秒）。
#                  上游集体故障时，超过这个预算就立刻降级到本地检索，
#                  避免用户在前端干等到浏览器超时。
LLM_TIMEOUT=60
LLM_PROBE_TIMEOUT=12
LLM_TOTAL_BUDGET=45
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# 可选：强制直连，不走系统代理
# LLM_NO_PROXY=1
