# ── LLM 配置样例 ──────────────────────────────────────────────────────
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略。
# 真实环境变量优先级高于 .env 文件。
#
# 这里配的是「默认模型」——应用开箱即用的那一套，也是每位使用者都拿到的兜底。
# 想临时换一个端点，不必改这个文件：「求教」页右上角的「模型」按钮里可以当场
# 填接口地址与 Key，或者在在线版上直接选 WorkBuddy 云模型。那两条路径只在你
# 自己的浏览器里保存，随每次请求一次性传给后端，不落盘。这份 .env 是它们的兜底。

# 任意 OpenAI 兼容端点即可（官方 OpenAI、智谱、各类聚合中继……）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here

# 显式指定模型。留空 = 自动从下面的候选里挑一个当前可用的
LLM_MODEL=

# 候选模型，逗号分隔，按优先级排列。留空则改用端点 /models 的返回
LLM_MODEL_CANDIDATES=gpt-4o-mini,gpt-4o

# 是否允许自动挑选可用模型（1/0）
LLM_AUTO_MODEL=1

# 超时与生成参数
# LLM_TIMEOUT：单个模型生成一次的最长等待（秒）
# LLM_PROBE_TIMEOUT：探活单个候选模型的最长等待（秒）
# LLM_TOTAL_BUDGET：一次问答里"探活 + 生成"的总预算（秒）。
#                  上游集体故障时，超过这个预算就立刻降级到本地检索，
#                  避免用户在前端干等到浏览器超时。
LLM_TIMEOUT=60
LLM_PROBE_TIMEOUT=12
LLM_TOTAL_BUDGET=45
# LLM_MAX_TOKENS：一次回答的长度上限。**调小会让长回答被拦腰截断在句子中间**
#                （实测约 950 字的回答在 2000 处断掉），所以给到 3000。
LLM_MAX_TOKENS=3000
LLM_TEMPERATURE=0.7

# 可选：强制直连，不走系统代理。对**模型调用与书籍检索同时**生效。
# LLM_NO_PROXY=1
# 旧名 RSDS_NO_PROXY 也认，两个设哪个都行（见 server/services/netproxy.py）。

# ── 历史记录（界面上的「回响」）──────────────────────────────────────
# 数据库不用配：首次运行时自动创建，默认落在程序目录下的 data/history.db。
# 程序目录不可写时（例如放进 Program Files）自动退到 %LOCALAPPDATA%\人生导师\。
#
# 下面两项平时不用动，一般只有调试时才改：
# RSDS_DATA_DIR=数据目录的绝对路径（把数据库放到别处）
# RSDS_HISTORY_RETENTION_DAYS=15（记录保留天数，默认半个月；设 0 即不留存）

# ── 内置管理员（后台管理用）──────────────────────────────────────────
# 第一次启动时会用这两个值建一个管理员账号，之后改这里**不会**改掉已存在的账号
# （密码要改请在后台「用户」页里点「重置密码」）。
#
# 不设就走下面的默认值。默认值是**公开的**，只适合本机开发；
# 一旦要让别人访问，务必换掉。
#
# RSDS_ADMIN_EMAIL=admin@renshengdaoshi.local
# RSDS_ADMIN_PASSWORD=admin123456
